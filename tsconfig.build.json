{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "resolveJsonModule": true,
    "rootDir": "src",
    "outDir": "dist/types"
  },
  "include": ["src"],
  "exclude": ["src/**/*.stories.tsx", "src/**/*.mdx", "src/demo"]
}
